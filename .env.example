# Cloudflare R2 Public CDN / Domain URL
VITE_CLOUDFLARE_R2_PUBLIC_URL="https://pub-your-id.r2.dev"

# Cloudflare Account ID & R2 S3 API Credentials (used by scripts/upload-to-r2.mjs)
